fig_kw_cotton <- ggbetweenstats(
data = dat_cotton,
x = species,
y = root_severity,
type = "np",
xlab = "",
ylab = "Disease severity",
p.adjust.method = "fdr",
package = "ggsci",
palette = "default_jco"
) +
theme_pubclean(base_size = 15, base_family = "Arial") +
theme(legend.position = "none") +
scale_x_discrete(labels = function(x) gsub("F. incarnatum", expression(italic("F. incarnatum")), x)) +
scale_x_discrete(labels = function(x) gsub("F. proliferatum", expression(italic("F. proliferatum")), x)) +
scale_x_discrete(labels = function(x) gsub("F. clavum", expression(italic("F. clavum")), x)) +
scale_x_discrete(labels = function(x) gsub("F. solani", expression(italic("F. solani")), x)) +
scale_x_discrete(labels = function(x) gsub("F. flocciferum", expression(italic("F. flocciferum")), x)) +
scale_x_discrete(labels = function(x) gsub("F. equiseti", expression(italic("F. equiseti")), x)) +
scale_x_discrete(labels = function(x) gsub("F. verticillioides", expression(italic("F. verticillioides")), x))
fig_kw_cotton
