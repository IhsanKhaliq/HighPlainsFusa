levels = c(
"F. incarnatum", "F. proliferatum", "F. clavum", "F. solani",
"F. flocciferum", "F. equiseti", "F. verticillioides", "Control"
),
labels = c(
"italic('F. incarnatum')",
"italic('F. proliferatum')",
"italic('F. clavum')",
"italic('F. solani')",
"italic('F. flocciferum')",
"italic('F. equiseti')",
"italic('F. verticillioides')",
"Control"  # Leave Control unformatted
)
)
